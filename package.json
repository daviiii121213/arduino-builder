{
  "name": "personal-life-ultra",
  "private": true,
  "version": "1.0.0",
  "description": "PERSONAL LIFE ULTRA — organização pessoal e familiar, 100% offline",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:core": "cargo run --manifest-path crates/plu-core/Cargo.toml --features devserver --bin plu-devserver -- .devdata",
    "build": "tsc --noEmit && vite build",
    "build:web": "node scripts/embed-wasm.mjs && vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "cargo test --manifest-path crates/plu-core/Cargo.toml",
    "test:e2e": "node tests/e2e/run.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-notification": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.3",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "3.2.7"
  }
}
