{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PERSONAL LIFE ULTRA",
  "mainBinaryName": "PersonalLifeUltra",
  "version": "1.0.0",
  "identifier": "com.personallifeultra.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PERSONAL LIFE ULTRA",
        "width": 1366,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Projeto PERSONAL LIFE ULTRA",
    "copyright": "Projeto PERSONAL LIFE ULTRA",
    "category": "Productivity",
    "shortDescription": "Organização pessoal e familiar offline",
    "longDescription": "Agenda, tarefas, projetos, metas, finanças, estudos, documentos, compras e organização familiar, com dados guardados apenas neste computador.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
