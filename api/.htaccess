# Projeto Gênesis — pasta api/
# Só o enviar.php pode ser chamado pelo navegador. Biblioteca, dados, configuração e registros ficam bloqueados.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <Files "enviar.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "enviar.php">
    Allow from all
  </Files>
</IfModule>
